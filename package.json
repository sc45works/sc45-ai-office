{
  "name": "command-center",
  "private": true,
  "version": "0.3.0",
  "description": "SC45WORKS AI Virtual Office Command Center: agents emit events, a local server streams them, a 3D office renders them.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sc45/server --filter @sc45/office dev",
    "dev:office": "pnpm --filter @sc45/office dev",
    "dev:server": "pnpm --filter @sc45/server dev",
    "start": "pnpm --filter @sc45/server start",
    "emit": "tsx scripts/emit.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "pnpm --filter @sc45/office build",
    "typecheck": "tsc -p packages/shared && tsc -p packages/bus && tsc -p packages/server && tsc -p packages/office && tsc -p .",
    "test": "tsx --test \"tests/*.test.ts\"",
    "build:hero": "pnpm --filter @sc45/office build:hero"
  },
  "dependencies": {
    "@sc45/bus": "workspace:*",
    "@sc45/shared": "workspace:*"
  },
  "devDependencies": {
    "@sc45/server": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "UNLICENSED"
}
